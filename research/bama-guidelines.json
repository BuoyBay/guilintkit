  "implemented": [
    {
      "id": "BAMA001",
      "summary": "Review off-grid authored positions under an explicitly adopted four-point policy.",
      "evidence": "Safe literal frames in supported parent coordinate spaces.",
      "exemptions": [
        "Root desktop placement",
        "Native control dimensions",
        "Positions 0, 1 and 2",
        "Computed or constrained geometry",
        "Hidden controls",
        "Documented per-control suppression"
      ],
      "source": "https://github.com/daveebbelaar/bama/blob/f0c2cdbf9e41d838c14d8b7596729581dd4833c0/skills/design/layout-grid/SKILL.md",
      "adaptation": "Checks positions only; Buoy cannot adopt SwiftUI controlSize or intrinsic-layout advice by forcing fixed heights."
    },
    {
      "id": "BAMA002",
      "summary": "Review explicitly fixed text smaller than ten points.",
      "evidence": "A positive numeric FontSize literal.",
      "exemptions": [
        "Zero uses the platform font default",
        "Expressions remain unverified",
        "Hidden/decorative controls",
        "Documented per-control suppression"
      ],
      "source": "https://github.com/daveebbelaar/bama/blob/f0c2cdbf9e41d838c14d8b7596729581dd4833c0/skills/design/ux-design/accessibility.md",
      "adaptation": "Advisory BAMA recommendation, not a universal minimum."
    },
    {
      "id": "BAMA003",
      "summary": "Review conflicting visible and explicit accessible wording.",
      "evidence": "Literal Caption or Label.Text and literal AccessibleLabel.",
      "exemptions": [
        "Icon-only captions",
        "Expanded labels retaining visible words",
        "Mnemonic markers and trailing ellipsis",
        "Expressions remain unverified",
        "Documented per-control suppression"
      ],
      "source": "https://github.com/daveebbelaar/bama/blob/f0c2cdbf9e41d838c14d8b7596729581dd4833c0/skills/design/ux-design/accessibility.md",
      "adaptation": "A wording heuristic; localization and intentional spoken alternatives may justify differences."
    }
  ],
